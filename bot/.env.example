# Скопіюйте цей файл у .env і впишіть свої значення.
# Файл .env не потрапляє в git (див. .gitignore).

# Токен бота від @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Telegram ID адмінів (баристи), через кому. Свій ID можна дізнатися командою /myid у боті
ADMIN_IDS=123456789

# HTTPS-адреса Mini App (GitHub Pages)
WEBAPP_URL=https://blessedrbls.github.io/coffee-miniapp/

# Необов'язково: файл бази замовлень (за замовчуванням bot/orders.db)
# DB_PATH=orders.db
